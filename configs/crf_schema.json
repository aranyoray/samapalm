 "screens": [
  {
   "id": "pid",
   "title": "Participant ID",
   "questions": [
    {
     "id": "study_id",
     "type": "pid",
     "label": "Participant ID (PID)",
     "required": true,
     "help": "Copy it from the paper consent form. Names stay on paper."
    }
   ]
  },
  {
   "id": "e_consent",
   "title": "Consent",
   "questions": [
    {
     "id": "consent",
     "type": "single",
     "label": "Signed consent form?",
     "choices": "yes_no",
     "required": true,
     "export": false,
     "stop_if": {
      "q": "consent",
      "eq": "no"
     },
     "stop_message": "No consent: save as a screen failure."
    },
    {
     "id": "stream",
     "type": "single",
     "label": "Study stream",
     "choices": "stream",
     "required": true,
     "default": "$settings.stream"
    },
    {
     "id": "dept",
     "type": "single",
     "label": "Department",
     "choices": "dept",
     "required": true
    }
   ]
  },
  {
   "id": "e_basics",
   "title": "Basics",
   "questions": [
    {
     "id": "age",
     "type": "integer",
     "label": "Age (years)",
     "required": true,
     "min": 18,
     "max": 110,
     "stop_if": {
      "q": "age",
      "lt": 18
     },
     "stop_message": "Under 18: not eligible. Save as a screen failure."
    },
    {
     "id": "sex",
     "type": "single",
     "label": "Sex",
     "choices": "sex",
     "required": true
    },
    {
     "id": "pregnant",
     "type": "single",
     "label": "Pregnant now?",
     "choices": "yes_no_unknown",
     "required": true,
     "show_if": {
      "all": [
       {
        "q": "sex",
        "eq": "F"
       },
       {
        "q": "age",
        "between": [
         18,
         55
        ]
       }
      ]
     }
    },
    {
     "id": "gestational_age_weeks",
     "type": "decimal",
     "label": "Weeks pregnant (from the antenatal card)",
     "required": true,
     "min": 4,
     "max": 42,
     "show_if": {
      "q": "pregnant",
      "eq": "yes"
     }
    },
    {
     "id": "trimester",
     "type": "computed",
     "label": "Trimester",
     "compute": "trimester",
     "export": true,
     "show_if": {
      "q": "pregnant",
      "eq": "yes"
     }
    },
    {
     "id": "height_cm",
     "type": "decimal",
     "label": "Height (cm)",
     "required": true,
     "min": 100,
     "max": 220
    },
    {
     "id": "weight_kg",
     "type": "decimal",
     "label": "Weight (kg)",
     "required": true,
     "min": 25,
     "max": 250
    },
    {
     "id": "bmi",
     "type": "computed",
     "label": "BMI (kg/m2)",
     "compute": "bmi",
     "export": true
    },
    {
     "id": "mst_band",
     "type": "mst",
     "label": "Skin tone (Monk scale)",
     "required": true,
     "min": 1,
     "max": 10,
     "help": "The participant picks from the printed card held against the back of the hand. The screen colours are only a guide.",
     "warn_if": {
      "q": "mst_band",
      "lt": 4
     },
     "warn_message": "Outside the target bands 4-10."
    }
   ]
  },
  {
   "id": "e_conditions",
   "title": "Known conditions",
   "questions": [
    {
     "id": "conditions",
     "type": "multi",
     "label": "Known conditions (tick all that apply)",
     "choices": "conditions",
     "required": true,
     "exclusive": [
      "none"
     ]
    },
    {
     "id": "htn_meds",
     "type": "single",
     "label": "How many blood pressure medicines?",
     "choices": "htn_meds",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "htn"
     }
    },
    {
     "id": "htn_meds_today",
     "type": "single",
     "label": "Took them today?",
     "choices": "yes_no",
     "required": true,
     "show_if": {
      "q": "htn_meds",
      "in": [
       "one",
       "two",
       "three_plus"
      ]
     }
    },
    {
     "id": "af_pattern",
     "type": "single",
     "label": "AF pattern",
     "choices": "af_pattern",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "af"
     }
    },
    {
     "id": "anticoagulant",
     "type": "single",
     "label": "On a blood thinner?",
     "choices": "yes_no_unknown",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "af"
     }
    },
    {
     "id": "arrhythmia_type",
     "type": "single",
     "label": "Which rhythm problem?",
     "choices": "arrhythmia_type",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "arrhythmia_other"
     }
    },
    {
     "id": "cardiac_device",
     "type": "single",
     "label": "Pacemaker or ICD?",
     "choices": "yes_no",
     "required": true,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "af"
       },
       {
        "q": "conditions",
        "contains": "arrhythmia_other"
       },
       {
        "q": "conditions",
        "contains": "heart_other"
       }
      ]
     }
    },
    {
     "id": "dm_type",
     "type": "single",
     "label": "Diabetes type",
     "choices": "dm_type",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "diabetes"
     }
    },
    {
     "id": "dm_years",
     "type": "integer",
     "label": "Years with diabetes",
     "required": false,
     "min": 0,
     "max": 80,
     "show_if": {
      "q": "conditions",
      "contains": "diabetes"
     }
    },
    {
     "id": "dm_treatment",
     "type": "single",
     "label": "Diabetes treatment",
     "choices": "dm_treatment",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "diabetes"
     }
    },
    {
     "id": "thal_type",
     "type": "single",
     "label": "Thalassaemia or HbE type",
     "choices": "thal_type",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "thal"
     }
    },
    {
     "id": "thal_transfusions",
     "type": "single",
     "label": "Blood transfusions for it",
     "choices": "thal_transfusions",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "thal"
     }
    },
    {
     "id": "iron_therapy",
     "type": "single",
     "label": "Iron treatment",
     "choices": "iron_therapy",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "ida"
     }
    },
    {
     "id": "on_dialysis",
     "type": "single",
     "label": "On dialysis?",
     "choices": "yes_no",
     "required": true,
     "show_if": {
      "q": "conditions",
      "contains": "ckd"
     }
    },
    {
     "id": "transfusion_3m",
     "type": "single",
     "label": "Blood transfusion in the last 3 months?",
     "choices": "yes_no_unknown",
     "required": true
    },
    {
     "id": "last_transfusion_date",
     "type": "date",
     "label": "Date of the last transfusion",
     "required": true,
     "show_if": {
      "q": "transfusion_3m",
      "eq": "yes"
     }
    }
   ]
  },
  {
   "id": "e_labs",
   "title": "Lab values on record",
   "questions": [
    {
     "id": "labs_note",
     "type": "info",
     "label": "Copy from records only. Leave blank if not on record."
    },
    {
     "id": "hb_gdl",
     "type": "decimal",
     "label": "Haemoglobin (g/dL)",
     "required": false,
     "min": 2,
     "max": 25
    },
    {
     "id": "hb_date",
     "type": "date",
     "label": "Haemoglobin date",
     "required_if": {
      "q": "hb_gdl",
      "answered": true
     }
    },
    {
     "id": "rbc_mill",
     "type": "decimal",
     "label": "RBC count (million/uL)",
     "required": false,
     "min": 1,
     "max": 9,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "mcv_fl",
     "type": "decimal",
     "label": "MCV (fL)",
     "required": false,
     "min": 40,
     "max": 130,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "mch_pg",
     "type": "decimal",
     "label": "MCH (pg)",
     "required": false,
     "min": 10,
     "max": 45,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "rdw_pct",
     "type": "decimal",
     "label": "RDW (%)",
     "required": false,
     "min": 8,
     "max": 35,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "mentzer",
     "type": "computed",
     "label": "Mentzer index (MCV / RBC)",
     "compute": "mentzer_index",
     "export": true,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "hplc_reflex",
     "type": "computed",
     "label": "Small or pale red cells: HPLC worth checking",
     "compute": "hplc_reflex",
     "export": true,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "ferritin_ngml",
     "type": "decimal",
     "label": "Ferritin (ng/mL)",
     "required": false,
     "min": 1,
     "max": 5000,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "ferritin_date",
     "type": "date",
     "label": "Ferritin date",
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "q": "conditions",
        "contains": "ida"
       },
       {
        "q": "conditions",
        "contains": "anaemia_other"
       },
       {
        "derived": "anaemic",
        "eq": true
       }
      ]
     },
     "required_if": {
      "q": "ferritin_ngml",
      "answered": true
     }
    },
    {
     "id": "hplc_result",
     "type": "single",
     "label": "HPLC result",
     "choices": "hplc_result",
     "required": false,
     "show_if": {
      "any": [
       {
        "q": "conditions",
        "contains": "thal"
       },
       {
        "derived": "hplc_reflex",
        "eq": true
       }
      ]
     }
    },
    {
     "id": "hba2_pct",
     "type": "decimal",
     "label": "HbA2 (%)",
     "required": false,
     "min": 0,
     "max": 20,
     "show_if": {
      "q": "hplc_result",
      "in": [
       "normal",
       "beta_trait",
       "hbe_trait",
       "hbe_beta",
       "beta_major_intermedia",
       "other"
      ]
     }
    },
    {
     "id": "hbf_pct",
     "type": "decimal",
     "label": "HbF (%)",
     "required": false,
     "min": 0,
     "max": 100,
     "show_if": {
      "q": "hplc_result",
      "in": [
       "normal",
       "beta_trait",
       "hbe_trait",
       "hbe_beta",
       "beta_major_intermedia",
       "other"
      ]
     }
    },
    {
     "id": "hbe_pct",
     "type": "decimal",
     "label": "HbE (%)",
     "required": false,
     "min": 0,
     "max": 100,
     "show_if": {
      "q": "hplc_result",
      "in": [
       "normal",
       "beta_trait",
       "hbe_trait",
       "hbe_beta",
       "beta_major_intermedia",
       "other"
      ]
     }
    },
    {
     "id": "hplc_date",
     "type": "date",
     "label": "HPLC date",
     "show_if": {
      "q": "hplc_result",
      "in": [
       "normal",
       "beta_trait",
       "hbe_trait",
       "hbe_beta",
       "beta_major_intermedia",
       "other"
      ]
     },
     "required_if": {
      "q": "hplc_result",
      "in": [
       "normal",
       "beta_trait",
       "hbe_trait",
       "hbe_beta",
       "beta_major_intermedia",
       "other"
      ]
     }
    },
    {
     "id": "hba1c_pct",
     "type": "decimal",
     "label": "HbA1c (%)",
     "required": false,
     "min": 3,
     "max": 20
    },
    {
     "id": "hba1c_date",
     "type": "date",
     "label": "HbA1c date",
     "required_if": {
      "q": "hba1c_pct",
      "answered": true
     }
    },
    {
     "id": "anaemia_grade",
     "type": "computed",
     "label": "Anaemia grade (WHO)",
     "compute": "anaemia_grade",
     "export": true
    },
    {
     "id": "haem_cell",
     "type": "computed",
     "label": "Blood group for recruitment",
     "compute": "haem_cell",
     "export": true
    },
    {
     "id": "dm_label",
     "type": "computed",
     "label": "Diabetes group for recruitment",
     "compute": "dm_label",
     "export": true
    }
   ]
  },
  {
   "id": "e_today",
   "title": "Today",
   "questions": [
    {
     "id": "acute_30m",
     "type": "multi",
     "label": "In the last 30 minutes",
     "choices": "acute",
     "required": true,
     "exclusive": [
      "none"
     ]
    },
    {
     "id": "last_meal_h",
     "type": "decimal",
     "label": "Hours since the last meal",
     "required": false,
     "min": 0,
     "max": 48
    },
    {
     "id": "glucose_mgdl",
     "type": "decimal",
     "label": "Finger-prick glucose (mg/dL)",
     "required": false,
     "min": 20,
     "max": 600,
     "help": "Only for participants in the glucose sub-study (separate consent)."
    }
   ]
  },
  {
   "id": "e_review",
   "title": "Review and submit",
   "questions": [
    {
     "id": "strata",
     "type": "computed",
     "label": "Recruitment groups",
     "compute": "strata",
     "export": true
    },
    {
     "id": "enrol_notes",
     "type": "text",
     "label": "Notes (optional)",
     "required": false
    }
   ]
  },
  {
   "id": "s_setup",
   "title": "Hand and cuff",
   "questions": [
    {
     "id": "imaged_hand",
     "type": "single",
     "label": "Hand to image",
     "choices": "hand",
     "required": true,
     "default": "$settings.imaged_hand"
    },
    {
     "id": "arm_circumference_cm",
     "type": "decimal",
     "label": "Upper-arm circumference (cm)",
     "required": true,
     "min": 15,
     "max": 55
    },
    {
     "id": "cuff_suggestion",
     "type": "computed",
     "label": "Suggested cuff",
     "compute": "cuff_suggestion"
    },
    {
     "id": "cuff_size",
     "type": "single",
     "label": "Cuff size used",
     "choices": "cuff_size",
     "required": true
    }
   ]
  },
  {
   "id": "bp1",
   "title": "BP1 on sitting down",
   "questions": [
    {
     "id": "bp1",
     "type": "bp",
     "label": "BP1 (first reading after sitting down)",
     "required": true
    },
    {
     "id": "rest_note",
     "type": "info",
     "label": "Rest starts now. Enrolment and history happen during the rest."
    }
   ]
  },
  {
   "id": "bp2",
   "title": "BP2 (end of rest)",
   "questions": [
    {
     "id": "rest_elapsed",
     "type": "computed",
     "label": "Rest since BP1",
     "compute": "rest_elapsed"
    },
    {
     "id": "bp2",
     "type": "bp",
     "label": "BP2",
     "required": true,
     "warn_if": {
      "derived": "bp1_outlier",
      "eq": true
     },
     "warn_message": "BP1 differs from BP2 by more than the outlier limit; it will be left out of the reference mean."
    },
    {
     "id": "irregular_pulse",
     "type": "single",
     "label": "Cuff showed an irregular-heartbeat sign on any reading?",
     "choices": "yes_no",
     "required": true,
     "export_as": "bool_yes_no"
    }
   ]
  },
  {
   "id": "clip1",
   "title": "Palm clip 1",
   "questions": [
    {
     "id": "clip1",
     "type": "clip",
     "label": "Clip 1 (Kardia between both thumbs, palm over the window)",
     "required": true
    }
   ]
  },
  {
   "id": "clip1b",
   "title": "Palm clip 1 re-shoot",
   "show_if": {
    "q": "clip1",
    "field": "quality",
    "eq": "fail"
   },
   "questions": [
    {
     "id": "clip1b",
     "type": "clip",
     "label": "Clip 1 re-shoot (once only)",
     "required": true
    }
   ]
  },
  {
   "id": "clip2",
   "title": "Palm clip 2",
   "questions": [
    {
     "id": "clip2",
     "type": "clip",
     "label": "Clip 2",
     "required": true
    }
   ]
  },
  {
   "id": "clip2b",
   "title": "Palm clip 2 re-shoot",
   "show_if": {
    "q": "clip2",
    "field": "quality",
    "eq": "fail"
   },
   "questions": [
    {
     "id": "clip2b",
     "type": "clip",
     "label": "Clip 2 re-shoot (once only)",
     "required": true
    }
   ]
  },
  {
   "id": "bp3",
   "title": "BP3 (after the clip)",
   "questions": [
    {
     "id": "bp3",
     "type": "bp",
     "label": "BP3",
     "required": true,
     "warn_if": {
      "derived": "bracket_flag",
      "eq": true
     },
     "warn_message": "Readings differ by more than the bracket limit; the visit is flagged."
    },
    {
     "id": "adverse_event",
     "type": "text",
     "label": "Anything go wrong for the participant? (leave blank if not)",
     "required": false
    }
   ]
  },
  {
   "id": "s_review",
   "title": "Review and submit",
   "questions": [
    {
     "id": "recovery",
     "type": "computed",
     "label": "Rest before the clip",
     "compute": "recovery",
     "export": true
    },
    {
     "id": "bracket_flag",
     "type": "computed",
     "label": "Readings too far apart",
     "compute": "bracket_flag",
     "export": true
    },
    {
     "id": "scan_strata",
     "type": "computed",
     "label": "Recruitment groups (scan)",
     "compute": "scan_strata",
     "export": true
    },
    {
     "id": "scan_notes",
     "type": "text",
     "label": "Notes (optional)",
     "required": false
    }
   ]
  }
 ]
}
